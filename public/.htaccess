# ==============================================================================
# Captalvo Apache Configuration
# AGGRESSIVE NO-CACHE FOR RAPID DEVELOPMENT & ITERATION
# ==============================================================================

# MIME Types
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/javascript .js
    AddType application/json .json
    AddType text/css .css
    AddType image/svg+xml .svg
</IfModule>

# Absolute Anti-Cache Headers (Server, CDN and Browser)
<IfModule mod_headers.c>
    # Security & Cross-Origin Isolation
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "require-corp"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Total Cache Annihilation (Browser, Proxies & Hostinger CDN)
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0"
    Header always set Pragma "no-cache"
    Header always set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    Header always set X-Accel-Expires "0"

    # Disable ETags
    Header unset ETag
    Header always unset ETag
</IfModule>

# Disable File ETag generation
FileETag None

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/wasm
</IfModule>

# Options
Options -Indexes
DirectoryIndex index.html index.php

# Routing & Rewrites
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to hidden/sensitive files
    RewriteRule ^(\.git|\.env|\.htaccess|.*\.ini|.*\.sql|.*\.bak) - [F,L]

    # Route /api/health to /api/health.php
    RewriteRule ^api/health/?$ api/health.php [L,QSA]

    # Route /api/* requests to /api/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api/index.php [L,QSA]
</IfModule>

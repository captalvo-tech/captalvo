# ==============================================================================
# Captalvo Apache Configuration
# AGGRESSIVE NO-CACHE FOR RAPID DEVELOPMENT & ITERATION
# DUAL-ENGINE ROUTING: WEBGL 2.0 & WEBGPU (ORIGAMI)
# ==============================================================================

# MIME Types
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/octet-stream .data
    AddType application/octet-stream .big
    AddType application/javascript .js
    AddType application/json .json
    AddType text/css .css
    AddType image/svg+xml .svg
</IfModule>

# Absolute Anti-Cache & Isolation Headers
<IfModule mod_headers.c>
    # Security & Cross-Origin Isolation for SharedArrayBuffer & WebGPU
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "require-corp"
    Header always set Cross-Origin-Resource-Policy "cross-origin"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Total Cache Annihilation (Browser, Proxies & Hostinger CDN)
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0"
    Header always set Pragma "no-cache"
    Header always set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    Header always set X-Accel-Expires "0"

    # Disable ETags
    Header unset ETag
    Header always unset ETag
</IfModule>

# Disable File ETag generation
FileETag None

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/wasm
</IfModule>

# Options
Options -Indexes
DirectoryIndex index.html index.php

# Routing & Rewrites
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to hidden/sensitive files
    RewriteRule ^(\.git|\.env|\.htaccess|.*\.ini|.*\.sql|.*\.bak) - [F,L]

    # Route WebGPU helper endpoints (Origami & Scorpion)
    RewriteRule ^(webgpu|scorpion)/?GeneralsXAssets/?$ api/index.php?endpoint=GeneralsXAssets [L,QSA]
    RewriteRule ^(webgpu|scorpion)/?GeneralsXLog/?$ api/index.php?endpoint=GeneralsXLog [L,QSA]
    RewriteRule ^(webgpu|scorpion)/?GeneralsXShare/?$ api/index.php?endpoint=GeneralsXShare [L,QSA]

    # Route /api/repair to /api/repair.php
    RewriteRule ^api/repair/?$ api/repair.php [L,QSA]

    # Route /api/health to /api/health.php
    RewriteRule ^api/health/?$ api/health.php [L,QSA]

    # Route /api/big-armada to /api/big-armada.php
    RewriteRule ^api/big-armada/?$ api/big-armada.php [L,QSA]

    # Scorpion binary asset fallback to webgpu if not present
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^scorpion/GeneralsXZH\.(wasm|data|js)$ webgpu/GeneralsXZH.$1 [L]

    # Route /api/* requests to /api/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api/index.php [L,QSA]
</IfModule>
